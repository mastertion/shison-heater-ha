# 复制本文件为 secrets.yaml，填入你自己的值。
# secrets.yaml 已被 .gitignore 排除，不会进入版本库。
#
# 注意：ESPHome 要求 secrets.yaml 与 YAML 配置在同一目录。

wifi_ssid: "你的WiFi名称"
wifi_password: "你的WiFi密码"

# 如果你的 ESPHome 设备开了 API 加密，取消 esp32_bt_proxy.yaml 里 api.encryption 的注释，
# 并把 32 字节 base64 密钥填在这里：
# api_encryption_key: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 如果开启了 OTA 密码：
# ota_password: "你的OTA密码"
